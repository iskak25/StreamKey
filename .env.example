# --- Firebase Web (публичная конфигурация, не секрет) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=streamkey-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=streamkey-dev
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (только сервер, хранить в секретах Vercel) ---
FIREBASE_PROJECT_ID=streamkey-dev
FIREBASE_CLIENT_EMAIL=
# Ключ одной строкой с \n
FIREBASE_PRIVATE_KEY=

# --- Криптография (base64, 32 байта; генерация: openssl rand -base64 32) ---
SESSION_HMAC_KEY_V1=
SESSION_HMAC_CURRENT_VERSION=1
RECEIPT_AES_KEY_V1=
RECEIPT_AES_CURRENT_VERSION=1

# --- Локальная разработка в эмуляторе ---
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Разовый bootstrap первого SUPER_ADMIN (после запуска удалить) ---
# BOOTSTRAP_ALLOWED=1

# --- Приложение ---
APP_ORIGIN=http://localhost:3000
# base64, 32 байта
CSRF_SECRET=
# Аварийный выключатель новых активаций и барьер ADR-0001 (воспроизведение закрыто, пока не "true")
ACTIVATIONS_DISABLED=false
YOUTUBE_PLAYBACK_ENABLED=false

# DEV ONLY: in-memory store + no sign-in. Server refuses to start with it in production.
DEMO_MODE=false
