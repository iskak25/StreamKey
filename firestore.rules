rules_version = '2';

// StreamKey: клиентский SDK не читает и не пишет бизнес-данные (ТЗ 13.3).
// Весь доступ — только через Next.js API + Firebase Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
